{
    "name": "@elizaos/agent",
    "version": "0.25.8",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "start": "node --loader ts-node/esm src/index.ts",
        "dev": "node --loader ts-node/esm src/index.ts",
        "check-types": "tsc --noEmit",
        "test": "jest"
    },
    "nodemonConfig": {
        "watch": [
            "src",
            "../core/dist"
        ],
        "ext": "ts,json",
        "exec": "node --enable-source-maps --loader ts-node/esm src/index.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.758.0",
        "@elizaos-plugins/adapter-supabase": "github:elizaos-plugins/adapter-supabase",
        "@elizaos-plugins/client-twitter": "github:elizaos-plugins/client-twitter",
        "@elizaos-plugins/plugin-image-generation": "github:elizaos-plugins/plugin-image-generation",
        "@elizaos-plugins/plugin-twitter": "github:elizaos-plugins/plugin-twitter",
        "@elizaos-plugins/plugin-web-search": "github:elizaos-plugins/plugin-web-search",
        "@elizaos/client-direct": "workspace:*",
        "@elizaos/core": "workspace:*",
        "@elizaos/plugin-bootstrap": "workspace:*",
        "readline": "1.3.0",
        "ws": "8.18.0",
        "yargs": "17.7.2",
        "zod": "3.24.1"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^22.13.5",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "ts-node": "10.9.2",
        "tsup": "8.3.5"
    }
}
