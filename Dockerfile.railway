# Optimized Dockerfile for Railway Deployment
# Multi-stage build to reduce image size and build time

# Build stage
FROM node:20-alpine AS builder

# Set working directory
WORKDIR /app

# Install pnpm globally
RUN npm install -g pnpm@latest turbo

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/*/package.json ./packages/

# Install dependencies with frozen lockfile (faster)
RUN pnpm install --frozen-lockfile --ignore-scripts

# Copy source files
COPY . .

# Build only the necessary packages (adjust as needed)
RUN pnpm run build:railway

# Production stage
FROM node:20-alpine AS runner

# Set working directory
WORKDIR /app

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000

# Copy package files
COPY --from=builder /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml /app/turbo.json ./

# Copy built packages and dependencies
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/core/dist ./packages/core/dist
COPY --from=builder /app/packages/core/package.json ./packages/core/
COPY --from=builder /app/packages/user-management-api/dist ./packages/user-management-api/dist
COPY --from=builder /app/packages/user-management-api/package.json ./packages/user-management-api/
COPY --from=builder /app/client/dist ./client/dist
COPY --from=builder /app/client/package.json ./client/

# Copy necessary files for runtime
COPY --from=builder /app/characters ./characters
COPY --from=builder /app/public ./public
COPY --from=builder /app/scripts ./scripts

# Expose port
EXPOSE 3000

# Start the application
CMD ["pnpm", "start"] 